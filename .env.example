# Strava OAuth Credentials (get these from https://www.strava.com/settings/apps)
# IMPORTANTE: STRAVA_CLIENT_SECRET debe estar SOLO en el servidor, NUNCA en el frontend
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# For local development with Vercel CLI
VERCEL_URL=http://localhost:3000
